{
  "name": "wassist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "ios": "npm run build && npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.1.4",
    "@capacitor/ios": "^6.2.2",
    "@capacitor/local-notifications": "^6.1.1",
    "dexie": "^4.0.8",
    "lucide-vue-next": "^0.454.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.10"
  }
}
